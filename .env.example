# Local Docker development only; replace for a hosted database. Never commit .env.
DATABASE_URL=postgresql://returndesk:local-development-only@localhost:5432/returndesk
# Tests must use a physically separate database. Never point this at demo/production.
TEST_DATABASE_URL=postgresql://returndesk:local-development-only@localhost:5433/returndesk_test

# Optional integration/browser verification only; never point at live/demo data.
TEST_BASE_URL=http://127.0.0.1:3000
# Set to 1 only when intentionally running synthetic test writes.
ALLOW_TEST_WRITES=0
# Optional additional protected URLs checked by the API test guard.
# DEMO_DATABASE_URL=postgresql://user:password@host:5432/returndesk_demo
# PRODUCTION_DATABASE_URL=postgresql://user:password@host:5432/returndesk_production
